diff --git a/Casterr/Playback/AudioTap.swift b/Casterr/Playback/AudioTap.swift
new file mode 100644
index 0000000..a479eda
--- /dev/null
+++ b/Casterr/Playback/AudioTap.swift
@@ -0,0 +1,280 @@
+import AudioToolbox
+import AVFoundation
+import CasterrCore
+import MediaToolbox
+import os
+import Synchronization
+
+/// Hears the audio as it plays. It keeps the loudness of the last 8 seconds for Back a Beat and,
+/// while voice boost is on, runs the audio through Apple's dynamics processor after measuring it.
+/// It taps the audio track before the speed change, so its times are media times at any speed.
+/// The tap callbacks run on a real-time audio thread: no allocation, no actors, only the unfair lock and atomics.
+final class AudioTap: Sendable {
+    private static let log = Logger(subsystem: "com.oribarilan.Casterr", category: "audioTap")
+    private let ring = OSAllocatedUnfairLock(initialState: Ring())
+    private let boostOn = Atomic<Bool>(false)
+    /// The dynamics processor's latest compression in dB, as Float bits, for the debug log.
+    private let compression = Atomic<UInt32>(0)
+    private let booster = Booster()
+
+    /// An audio mix that sends `track` through this tap, or nil if the tap can't be made.
+    func audioMix(for track: AVAssetTrack) -> AVAudioMix? {
+        var callbacks = MTAudioProcessingTapCallbacks(
+            version: kMTAudioProcessingTapCallbacksVersion_0,
+            clientInfo: Unmanaged.passRetained(self).toOpaque(),
+            init: { _, clientInfo, storage in storage.pointee = clientInfo },
+            finalize: { tap in Unmanaged<AudioTap>.fromOpaque(MTAudioProcessingTapGetStorage(tap)).release() },
+            prepare: { tap, maxFrames, format in
+                let me = AudioTap.from(tap), format = format.pointee
+                me.ring.withLock { $0.prepare(format) }
+                if !me.booster.prepare(tap, maxFrames: maxFrames, format: format, refCon: Unmanaged.passUnretained(me).toOpaque()) {
+                    AudioTap.log.debug("Voice boost can't process this audio format; it plays unboosted")
+                }
+            },
+            unprepare: { tap in AudioTap.from(tap).booster.unprepare() },
+            process: { tap, frames, _, buffers, framesOut, flagsOut in
+                let me = AudioTap.from(tap)
+                if me.boostOn.load(ordering: .relaxed),
+                   let amount = me.booster.render(frames: frames, into: buffers, framesOut: framesOut, flagsOut: flagsOut) {
+                    me.compression.store(amount.bitPattern, ordering: .relaxed)
+                    return
+                }
+                me.booster.isRunning = false
+                var range = CMTimeRange()
+                guard MTAudioProcessingTapGetSourceAudio(tap, frames, buffers, flagsOut, &range, framesOut) == noErr
+                else { return }
+                me.hear(buffers, frames: Int(framesOut.pointee), at: range.start.seconds)
+            }
+        )
+        var tap: MTAudioProcessingTap?
+        guard MTAudioProcessingTapCreate(nil, &callbacks, kMTAudioProcessingTapCreationFlag_PreEffects, &tap) == noErr,
+              let tap
+        else {
+            Unmanaged.passUnretained(self).release()
+            return nil
+        }
+        let input = AVMutableAudioMixInputParameters(track: track)
+        input.audioTapProcessor = tap
+        let mix = AVMutableAudioMix()
+        mix.inputParameters = [input]
+        return mix
+    }
+
+    func loudness(from start: TimeInterval, to end: TimeInterval) -> [Loudness] {
+        ring.withLock { $0.readings(from: start, to: end) }
+    }
+
+    func setVoiceBoost(_ isOn: Bool) {
+        boostOn.store(isOn, ordering: .relaxed)
+    }
+
+    /// How hard the dynamics processor is working, in dB. Zero when boost is off or hasn't run.
+    var compressionAmount: Float {
+        Float(bitPattern: compression.load(ordering: .relaxed))
+    }
+
+    /// Measures the source audio. Unchecked: the buffer pointer is only used inside the lock, on this thread.
+    fileprivate func hear(_ buffers: UnsafeMutablePointer<AudioBufferList>, frames: Int, at start: TimeInterval) {
+        let list = UnsafeMutableAudioBufferListPointer(buffers)
+        ring.withLockUnchecked { $0.add(list, frames: frames, at: start) }
+    }
+
+    /// The dynamics processor asks for its input here.
+    fileprivate func pullForBooster(frames: UInt32, into buffers: UnsafeMutablePointer<AudioBufferList>) -> OSStatus {
+        booster.pull(self, frames: frames, into: buffers)
+    }
+
+    fileprivate static func from(_ tap: MTAudioProcessingTap) -> AudioTap {
+        Unmanaged<AudioTap>.fromOpaque(MTAudioProcessingTapGetStorage(tap)).takeUnretainedValue()
+    }
+}
+
+/// Voice boost: Apple's dynamics processor with the values the listener approved by ear.
+/// Only the tap's callbacks touch it, and MediaToolbox calls them one at a time, so it needs no lock.
+private final class Booster: @unchecked Sendable {
+    static let settings: [(AudioUnitParameterID, AudioUnitParameterValue)] = [
+        (kDynamicsProcessorParam_Threshold, -38),
+        (kDynamicsProcessorParam_HeadRoom, 3),
+        (kDynamicsProcessorParam_AttackTime, 0.003),
+        (kDynamicsProcessorParam_ReleaseTime, 0.3),
+        (kDynamicsProcessorParam_OverallGain, 24),
+        (kDynamicsProcessorParam_ExpansionRatio, 1),
+    ]
+
+    private var unit: AudioUnit?
+    private var tap: MTAudioProcessingTap?
+    private var sampleTime: Float64 = 0
+    /// False until the unit renders after boost turns on; a fresh start resets the unit's envelope.
+    var isRunning = false
+    /// What the last source pull returned, for the process callback to report.
+    private var pulled: (frames: CMItemCount, flags: MTAudioProcessingTapFlags)?
+
+    /// Sets up the unit for the tap's format. False when the format can't be boosted.
+    func prepare(_ tap: MTAudioProcessingTap, maxFrames: CMItemCount, format: AudioStreamBasicDescription, refCon: UnsafeMutableRawPointer) -> Bool {
+        self.tap = tap
+        guard format.mFormatFlags & kAudioFormatFlagIsFloat != 0, format.mBitsPerChannel == 32 else { return false }
+        var description = AudioComponentDescription(
+            componentType: kAudioUnitType_Effect, componentSubType: kAudioUnitSubType_DynamicsProcessor,
+            componentManufacturer: kAudioUnitManufacturer_Apple, componentFlags: 0, componentFlagsMask: 0)
+        guard let component = AudioComponentFindNext(nil, &description) else { return false }
+        var newUnit: AudioUnit?
+        guard AudioComponentInstanceNew(component, &newUnit) == noErr, let newUnit else { return false }
+        var streamFormat = format
+        var frames = UInt32(maxFrames)
+        var callback = AURenderCallbackStruct(inputProc: pullSource, inputProcRefCon: refCon)
+        let formatSize = UInt32(MemoryLayout<AudioStreamBasicDescription>.size)
+        let ready = AudioUnitSetProperty(newUnit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &streamFormat, formatSize) == noErr
+            && AudioUnitSetProperty(newUnit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Output, 0, &streamFormat, formatSize) == noErr
+            && AudioUnitSetProperty(newUnit, kAudioUnitProperty_MaximumFramesPerSlice, kAudioUnitScope_Global, 0, &frames, UInt32(MemoryLayout<UInt32>.size)) == noErr
+            && AudioUnitSetProperty(newUnit, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input, 0, &callback, UInt32(MemoryLayout<AURenderCallbackStruct>.size)) == noErr
+            && AudioUnitInitialize(newUnit) == noErr
+        guard ready else {
+            AudioComponentInstanceDispose(newUnit)
+            return false
+        }
+        for (parameter, value) in Self.settings {
+            AudioUnitSetParameter(newUnit, parameter, kAudioUnitScope_Global, 0, value, 0)
+        }
+        unit = newUnit
+        sampleTime = 0
+        isRunning = false
+        return true
+    }
+
+    func unprepare() {
+        if let unit {
+            AudioUnitUninitialize(unit)
+            AudioComponentInstanceDispose(unit)
+        }
+        unit = nil
+        tap = nil
+    }
+
+    /// Renders boosted audio into `buffers`. The unit pulls the source through `pullSource`, which also
+    /// measures it. Returns the compression in dB, or nil when there's no unit, so the caller plays it plain.
+    func render(frames: CMItemCount, into buffers: UnsafeMutablePointer<AudioBufferList>,
+                framesOut: UnsafeMutablePointer<CMItemCount>, flagsOut: UnsafeMutablePointer<MTAudioProcessingTapFlags>) -> Float? {
+        guard let unit else { return nil }
+        if !isRunning {
+            AudioUnitReset(unit, kAudioUnitScope_Global, 0)
+            isRunning = true
+        }
+        var timeStamp = AudioTimeStamp()
+        timeStamp.mFlags = .sampleTimeValid
+        timeStamp.mSampleTime = sampleTime
+        var actionFlags = AudioUnitRenderActionFlags()
+        pulled = nil
+        let status = AudioUnitRender(unit, &actionFlags, &timeStamp, 0, UInt32(frames), buffers)
+        sampleTime += Float64(frames)
+        // Once the source was pulled it can't be pulled again, so report it even if the unit failed.
+        guard let pulled else { return nil }
+        framesOut.pointee = pulled.frames
+        flagsOut.pointee = pulled.flags
+        guard status == noErr else { return 0 }
+        var amount: AudioUnitParameterValue = 0
+        AudioUnitGetParameter(unit, kDynamicsProcessorParam_CompressionAmount, kAudioUnitScope_Global, 0, &amount)
+        return amount
+    }
+
+    /// The unit's input: the tap's source audio, measured for Back a Beat before the unit changes it.
+    fileprivate func pull(_ tapOwner: AudioTap, frames: UInt32, into buffers: UnsafeMutablePointer<AudioBufferList>) -> OSStatus {
+        guard let tap else { return kAudioUnitErr_NoConnection }
+        var range = CMTimeRange()
+        var count: CMItemCount = 0
+        var flags: MTAudioProcessingTapFlags = 0
+        let status = MTAudioProcessingTapGetSourceAudio(tap, CMItemCount(frames), buffers, &flags, &range, &count)
+        guard status == noErr else { return status }
+        pulled = (count, flags)
+        tapOwner.hear(buffers, frames: Int(count), at: range.start.seconds)
+        return noErr
+    }
+}
+
+private let pullSource: AURenderCallback = { refCon, _, _, _, frames, buffers in
+    guard let buffers else { return kAudio_ParamError }
+    let tap = Unmanaged<AudioTap>.fromOpaque(refCon).takeUnretainedValue()
+    return tap.pullForBooster(frames: frames, into: buffers)
+}
+
+/// The last 800 readings (8 seconds), in fixed arrays so the audio thread never allocates.
+private struct Ring {
+    static let capacity = 800
+    private var times = [TimeInterval](repeating: 0, count: capacity)
+    private var levels = [Float](repeating: 0, count: capacity)
+    private var count = 0
+    private var next = 0
+
+    private var sampleRate: Double = 0
+    private var isFloat = false
+    private var isInt16 = false
+    /// The slice being summed: its start time, sum of squares, and frames so far.
+    private var sliceStart: TimeInterval = 0
+    private var sliceSum: Double = 0
+    private var sliceFrames = 0
+    private var expected: TimeInterval = -1
+
+    mutating func prepare(_ format: AudioStreamBasicDescription) {
+        sampleRate = format.mSampleRate
+        isFloat = format.mFormatFlags & kAudioFormatFlagIsFloat != 0 && format.mBitsPerChannel == 32
+        isInt16 = format.mFormatFlags & kAudioFormatFlagIsSignedInteger != 0 && format.mBitsPerChannel == 16
+        count = 0
+        next = 0
+        expected = -1
+    }
+
+    mutating func add(_ list: UnsafeMutableAudioBufferListPointer, frames: Int, at start: TimeInterval) {
+        guard sampleRate > 0, isFloat || isInt16, frames > 0, start.isFinite else { return }
+        if abs(start - expected) > Loudness.slice {
+            // A seek, or a pause that renders the last moment again. Readings are keyed by media time,
+            // so the earlier ones still hold; drop only those at or after the new start.
+            while count > 0, times[(next - 1 + Self.capacity) % Self.capacity] >= start {
+                next = (next - 1 + Self.capacity) % Self.capacity
+                count -= 1
+            }
+            sliceStart = start
+            sliceSum = 0
+            sliceFrames = 0
+        }
+        let perSlice = Int(sampleRate * Loudness.slice)
+        for frame in 0..<frames {
+            var sum: Double = 0
+            var channels = 0
+            for buffer in list {
+                guard let data = buffer.mData else { continue }
+                let width = Int(buffer.mNumberChannels)
+                for channel in 0..<width {
+                    let index = frame * width + channel
+                    let sample = isFloat
+                        ? Double(data.assumingMemoryBound(to: Float.self)[index])
+                        : Double(data.assumingMemoryBound(to: Int16.self)[index]) / Double(Int16.max)
+                    sum += sample * sample
+                }
+                channels += width
+            }
+            guard channels > 0 else { return }
+            sliceSum += sum / Double(channels)
+            sliceFrames += 1
+            if sliceFrames == perSlice {
+                append(Loudness(time: sliceStart, level: Float((sliceSum / Double(sliceFrames)).squareRoot())))
+                sliceStart = start + Double(frame + 1) / sampleRate
+                sliceSum = 0
+                sliceFrames = 0
+            }
+        }
+        expected = start + Double(frames) / sampleRate
+    }
+
+    func readings(from start: TimeInterval, to end: TimeInterval) -> [Loudness] {
+        (0..<count)
+            .map { (next - count + $0 + Self.capacity) % Self.capacity }
+            .map { Loudness(time: times[$0], level: levels[$0]) }
+            .filter { $0.time >= start && $0.time < end }
+    }
+
+    private mutating func append(_ reading: Loudness) {
+        times[next] = reading.time
+        levels[next] = reading.level
+        next = (next + 1) % Self.capacity
+        count = min(count + 1, Self.capacity)
+    }
+}
